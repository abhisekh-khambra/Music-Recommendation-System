        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 0,
          "endMs": 7200,
          "text": "नमस्ते, आइए बैठिए। पिछले हफ़्ते से आप कैसा महसूस कर रही हैं?",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 7700,
          "endMs": 17732,
          "text": "सच कहूँ तो बहुत तनाव में हूँ। ऑफिस में काम इतना ज़्यादा है कि रात को नींद ही नहीं आती, दिल घबराता रहता है।",
          "emotion": "STRESS"
        },
        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 18632,
          "endMs": 26816,
          "text": "यह तो काफ़ी थका देने वाला लगता है। घर पर किसी से इस बारे में बात होती है?",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 27416,
          "endMs": 36152,
          "text": "नहीं, मैं अकेली रहती हूँ। कभी कभी इतना अकेलापन लगता है कि बस रोना आ जाता है।",
          "emotion": "SADNESS"
        },
        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 37252,
          "endMs": 41332,
          "text": "आपको आख़िरी बार कब अच्छा महसूस हुआ था?",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 41732,
          "endMs": 51476,
          "text": "पिछले महीने गाँव गई थी, माँ के हाथ का खाना खाया, बचपन की गलियों में घूमी। वो दिन बहुत याद आते हैं।",
