        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 38020,
          "endMs": 42148,
          "text": "That must be painful, especially with family.",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 42848,
          "endMs": 52040,
          "text": "It is. After the fight I just cried. I feel lonely and sad, like nobody is on my side.",
          "emotion": "SADNESS"
        },
        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 52540,
          "endMs": 55948,
          "text": "Was there a time you felt close to him?",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 56848,
          "endMs": 64936,
          "text": "When we were kids we used to fly kites on the terrace every Sankranti. I miss those days so much.",
          "emotion": "NOSTALGIA"
        },
        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 65536,
          "endMs": 69592,
          "text": "Holding on to that memory might help you reconnect.",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 70692,
          "endMs": 76188,
          "text": "Maybe. Right now I still feel heavy and sad inside.",
          "emotion": "SADNESS"
        },
        {
          "role": "HEALTH_CONSULTANT",
          "startMs": 76588,
          "endMs": 79684,
          "text": "Let us take a slow breath together.",
          "emotion": null
        },
        {
          "role": "PATIENT",
          "startMs": 80484,
          "endMs": 85380,
          "text": "Okay. That feels a little calmer, thank you.",
          "emotion": "CALM"
        }
      ]
    },
